#!/usr/bin/env bash
# fleet: creates a Claude Code account for Zed's agent panel (see FLEET.md, "Agent accounts").
# Usage: script/fleet-add-account <name>
#
# Creates ~/.claude-<name>, symlinks account-independent config and the conversation history
# from ~/.claude into it (so every account shares settings and sees the same threads), and
# adds a `claude-acp@<name>` entry to Zed's settings.json.

set -euo pipefail

name="${1:-}"
if [[ ! "$name" =~ ^[a-z0-9_-]+$ ]]; then
    echo "usage: $0 <name>   (name: lowercase letters, digits, '-' or '_')" >&2
    exit 1
fi

shared_dir="$HOME/.claude"
account_dir="$HOME/.claude-$name"
settings_path="${XDG_CONFIG_HOME:-$HOME/.config}/zed/settings.json"

mkdir -p "$account_dir"
chmod 700 "$account_dir"

# Credentials (.credentials.json) and identity (.claude.json) are per account and must
# never be linked; everything below is account-independent.
for item in settings.json keybindings.json CLAUDE.md skills commands agents projects history.jsonl; do
    source="$shared_dir/$item"
    target="$account_dir/$item"
    [[ -e "$source" ]] || continue
    if [[ -L "$target" ]]; then
        continue
    fi
    if [[ -e "$target" ]]; then
        echo "skipping $target: already exists and is not a symlink" >&2
        continue
    fi
    ln -s -- "$source" "$target"
done

python3 - "$settings_path" "$name" "$account_dir" <<'EOF'
import json
import os
import sys

settings_path, name, account_dir = sys.argv[1:]
agent_id = f"claude-acp@{name}"
entry = {"type": "registry", "env": {"CLAUDE_CONFIG_DIR": account_dir}}

settings = {}
if os.path.exists(settings_path):
    with open(settings_path) as file:
        text = file.read()
    try:
        settings = json.loads(text) if text.strip() else {}
    except json.JSONDecodeError:
        # Zed settings allow comments and trailing commas, which json can't round-trip.
        print(f"{settings_path} is not plain JSON; add this under \"agent_servers\" yourself:")
        print(json.dumps({agent_id: entry}, indent=2))
        sys.exit(0)

agent_servers = settings.setdefault("agent_servers", {})
if agent_id in agent_servers:
    print(f"{agent_id} already in {settings_path}")
    sys.exit(0)
agent_servers[agent_id] = entry

os.makedirs(os.path.dirname(settings_path), exist_ok=True)
temporary_path = settings_path + ".tmp"
with open(temporary_path, "w") as file:
    json.dump(settings, file, indent=2)
    file.write("\n")
os.replace(temporary_path, settings_path)
print(f"added {agent_id} to {settings_path}")
EOF

echo "account dir: $account_dir"
echo "log in once: CLAUDE_CONFIG_DIR=$account_dir claude, then /login"
echo "or start a thread with \"Claude Agent ($name)\" in Zed and follow its login prompt."
