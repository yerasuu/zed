#!/usr/bin/env bash
# fleet: builds target/Zed-fleet-x86_64.AppImage from this checkout (see FLEET.md, "AppImage").
# Zed is built by the repo's flake, so only files tracked by git are included.
#
# Everything the build leaves in /nix/store is either deleted or owned by target/: per-build
# paths are deleted once the image is copied out, and the reusable build inputs are kept alive
# by the GC root target/fleet-build-cache, so deleting target/ and running `nix store gc` frees
# all of it.

set -euo pipefail

nix() {
    command nix --extra-experimental-features 'nix-command flakes' "$@"
}

# Deletes the store paths read from stdin. Paths still in use elsewhere (e.g. installed in a
# profile) are refused by Nix and kept. A path can't go while another refers to it, so this
# repeats until a pass deletes nothing.
delete_paths() {
    local paths remaining path
    mapfile -t paths
    while ((${#paths[@]})); do
        remaining=()
        for path in "${paths[@]}"; do
            [[ -e "$path" ]] || continue
            nix store delete "$path" &>/dev/null || remaining+=("$path")
        done
        ((${#remaining[@]} < ${#paths[@]})) || break
        paths=("${remaining[@]}")
    done
}

repo="$(git rev-parse --show-toplevel)"
output="$repo/target/Zed-fleet-x86_64.AppImage"
image_link="$repo/target/fleet-appimage"
cache_link="$repo/target/fleet-build-cache"
mkdir -p "$repo/target"
scratch="$(mktemp -d "$repo/target/fleet-appimage.XXXXXX")"
trap 'rm -rf "$scratch"' EXIT
flake="(builtins.getFlake \"git+file://$repo\")"
pkgs="$flake.inputs.nixpkgs.legacyPackages.x86_64-linux"

nix bundle \
    --bundler github:ralismark/nix-appimage \
    --out-link "$image_link" \
    --impure --expr "
        import $repo/nix/fleet/appimage.nix {
          pkgs = $pkgs;
          zed-editor = $flake.packages.x86_64-linux.default;
        }"

image="$(readlink -f "$image_link")"
# The bundle is a read-only store path; copy it so the image can be moved and run anywhere.
install -m 755 "$image" "$output"
rm "$image_link"

# Per-build paths change with every commit. Most depend on a snapshot of the repo (the flake's
# copy, and the filtered `src` of nix/build.nix): the snapshots, their referrers and the
# referrers' outputs. Crane's deps build only sees a dummy source, but its name carries the
# package version, which includes the commit SHA, so it is never reused either.
sources=(
    "$(nix eval --impure --raw --expr "$flake.outPath")"
    "$(nix eval --impure --raw --expr "toString $flake.packages.x86_64-linux.default.src")"
)
version="$(nix eval --impure --raw --expr "$flake.packages.x86_64-linux.default.version")"
image_drv="$(nix-store --query --deriver "$image")"
nix-store --query --requisites --include-outputs "$image_drv" |
    grep -v '\.drv$' | sort -u >"$scratch/closure"
# Derivations count too: a `.drv` refers to its inputs, and Nix won't delete a path that is
# still referred to.
{
    nix-store --query --referrers-closure "${sources[@]}"
    nix-store --query --requisites "$image_drv" | grep -F -- "-$version"
} | sort -u >"$scratch/per-build-drvs"
{
    cat "$scratch/per-build-drvs"
    grep '\.drv$' "$scratch/per-build-drvs" | xargs -r nix-store --query --outputs
    grep -F -- "-$version" "$scratch/closure" || true
} | sort -u >"$scratch/per-build"

# Everything else the build used is reusable by the next one, so root it from target/.
comm -23 "$scratch/closure" "$scratch/per-build" >"$scratch/cache"
python3 -c 'import json, sys; print(json.dumps(sys.stdin.read().split()))' \
    <"$scratch/cache" >"$scratch/cache.json"
previous_cache="$(readlink -e "$cache_link" || true)"
nix build --out-link "$cache_link" --impure --expr "
    $pkgs.writeText \"fleet-build-cache\" (builtins.concatStringsSep \"\n\"
      (map builtins.storePath (builtins.fromJSON (builtins.readFile $scratch/cache.json))))"

delete_paths <"$scratch/per-build"

# Inputs only the previous build needed (e.g. crates dropped from Cargo.lock) just lost their
# root; delete them now rather than leaving them for a store-wide GC.
if [[ -e "$previous_cache" && "$previous_cache" != "$(readlink -f "$cache_link")" ]]; then
    {
        echo "$previous_cache"
        nix-store --query --deriver "$previous_cache"
        sort -u "$previous_cache" | comm -23 - "$scratch/cache"
    } | delete_paths
fi

echo "$output"
